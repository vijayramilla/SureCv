# Firebase (required for login, saved resumes, billing)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# SureCV Intelligence backend keys (required for optimization)
VITE_GEMINI_API_KEY=
# Server-side ATS scoring (same key; loaded by npm run server)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
VITE_GROQ_API_KEY=
VITE_GROQ_API_KEY_SECONDARY=
VITE_OPENAI_API_KEY=

# Puppeteer scraper (optional — use npm run dev:full; Vite proxies /api)
# VITE_SCRAPER_API_URL=http://localhost:8787

# Payments (optional)
VITE_RAZORPAY_KEY_ID=
