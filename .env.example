# Firebase (required for login, saved resumes, billing)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# SureCV Intelligence backend keys (required for optimization)
VITE_GEMINI_API_KEY=
# Server-side ATS scoring (same key; loaded by npm run server)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
VITE_NVIDIA_API_KEY=
NVIDIA_API_KEY=
VITE_GROQ_API_KEY=
VITE_GROQ_API_KEY_SECONDARY=
VITE_OPENAI_API_KEY=

# SureCv backend proxy (NVIDIA NIM — keys live in server/.env / Railway only)
# Local:
VITE_API_URL=http://localhost:3001
# Production (Vercel env for https://surecv.in):
# VITE_API_URL=https://api.surecv.in

# Puppeteer scraper (optional — use npm run dev:full; Vite proxies /api)
# VITE_SCRAPER_API_URL=http://localhost:8787

# Payments (Razorpay - LIVE MODE - Get keys from Razorpay Dashboard)
VITE_RAZORPAY_KEY_ID=
VITE_RAZORPAY_SECRET_KEY=
